# 复制为 .env 后按需修改。.env 已在 .gitignore 中，不要提交真实密钥。

# ── 必填 ────────────────────────────────────────────────

# 站长账号。该账号不存在于数据库用户表，仅由环境变量决定
ICETV_USERNAME=admin
ICETV_PASSWORD=change_me

# 会话与代理签名密钥。至少 32 字符高熵随机串
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 更换后所有已登录会话立即失效
AUTH_SECRET=change_me_to_a_random_32_plus_char_secret

# 旧版本启动脚本兼容名，不建议新部署使用；服务端实际校验请使用 AUTH_SECRET
# ICETV_AUTH_SECRET=

# 登录态有效时长（小时），默认 168
# AUTH_SESSION_TTL_HOURS=168

# 旧签名兼容截止时间（ISO 8601），默认 2026-08-01T00:00:00.000Z
# 到期后旧登录态需重新登录
# LEGACY_COOKIE_CUTOFF_DATE=2026-08-01T00:00:00.000Z

# ── 存储 ────────────────────────────────────────────────

# localdb 用 SQLite，mysql 用 MySQL
# 不填时：设了 DATABASE_URL 走 mysql，否则走 localdb
NEXT_PUBLIC_STORAGE_TYPE=localdb

# SQLite 数据库路径。Docker 内默认 /data/icetv-data.sqlite
# LOCAL_DB_PATH=./data/icetv-data.sqlite

# MySQL 连接串。用户名或密码含 @ : / # 等字符需 URL 编码
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/icetv

# 云数据库要求 TLS 时填 CA 的 PEM 文本。连接串里的 ssl-mode 参数不生效
# MYSQL_SSL_CA=

# MySQL TLS 证书校验，默认 true；仅排查自签名证书问题时临时改为 false
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# MySQL 连接池。默认连接上限 5，空闲连接数默认为上限的一半，空闲超时 60000ms
# MYSQL_CONNECTION_LIMIT=5
# MYSQL_MAX_IDLE=3
# MYSQL_IDLE_TIMEOUT_MS=60000

# SQLite 锁等待与初始化重试。代码默认 5000ms、重试 8 次、间隔 250ms；Docker 镜像锁等待默认 20000ms
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_INIT_RETRY_COUNT=8
# SQLITE_INIT_RETRY_DELAY_MS=250

# SQLite 页缓存与内存映射。默认页缓存 16384 KiB、映射 128 MiB；小内存实例可调小
# SQLITE_CACHE_SIZE_KIB=16384
# SQLITE_MMAP_SIZE_BYTES=134217728

# ── 性能 ────────────────────────────────────────────────

# 服务端内存缓存档位。small 约 100 MiB 上限，适合 1C1G 小鸡
# standard 约 312 MiB 上限，适合 2C4G 以上。默认 small
# CACHE_PROFILE=small

# 跨请求共享的上游搜索并发上限。不填按档位取（small 12，standard 24）
# 多人同时搜索时上游请求排队而不是叠加，单人搜索速度不受影响
# UPSTREAM_SEARCH_CONCURRENCY=12

# 配置缓存 TTL，默认 60000ms
# CONFIG_CACHE_TTL_MS=60000

# 外部请求与 DNS 缓存。默认 15000ms、30000ms、5000ms
# PROXY_FETCH_TIMEOUT_MS=15000
# PROXY_DNS_CACHE_TTL_MS=30000
# PROXY_DNS_NEGATIVE_CACHE_TTL_MS=5000

# 生产环境出站代理（可选）；开发环境优先使用 DEV_HTTP_PROXY
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890

# 搜索源失败冷却时间，默认 300000ms
# SEARCH_SOURCE_FAILURE_COOLDOWN_MS=300000

# 直播源刷新并发，默认 2，最大 2
# LIVE_REFRESH_CONCURRENCY=2

# ── 定时任务 ────────────────────────────────────────────

# Docker 部署必填，用于校验定时任务调用方
# CRON_SECRET=change_me_to_another_random_secret

# 服务启动后首次执行任务的延迟与任务间错峰，默认 60000ms / 15000ms
# CRON_INITIAL_DELAY_MS=60000
# CRON_START_STAGGER_MS=15000

# 各任务周期，默认配置/元数据 6 小时、直播 1 小时
# CRON_CONFIG_INTERVAL_MS=21600000
# CRON_LIVE_INTERVAL_MS=3600000
# CRON_METADATA_INTERVAL_MS=21600000

# 元数据刷新 TTL、总时间预算和每类最大条数
# 默认 TTL 6 小时、预算 300000ms、播放记录 80 条、收藏 40 条
# CRON_METADATA_REFRESH_TTL_MS=21600000
# CRON_METADATA_TIME_BUDGET_MS=300000
# CRON_METADATA_RECORD_MAX_ITEMS=80
# CRON_METADATA_FAVORITE_MAX_ITEMS=40
# 旧版统一上限变量（仅在未设置播放记录专用上限时生效）
# CRON_METADATA_MAX_ITEMS=80

# 元数据刷新每次从数据库读取的条数。默认 100，调小可降低单次峰值，调大可减少查询次数
# CRON_METADATA_PAGE_SIZE=100

# 播放统计保留天数，默认 0（不自动清理）；cron 文件锁默认在 Docker 为 /data/icetv-cron.lock
# CRON_PLAYBACK_STATS_RETENTION_DAYS=0
# CRON_LOCK_PATH=/data/icetv-cron.lock
# CRON_LOCK_TTL_MS=900000

# start.js 等待服务就绪的超时，默认 120000ms
# READY_POLL_TIMEOUT_MS=120000

# HTTP 监听端口，Docker 镜像默认 3000
# PORT=3000

# 旧版本启动脚本兼容名，不建议新部署使用；cron 接口实际校验请使用 CRON_SECRET
# ICETV_CRON_SECRET=
# VERCEL_CRON_SECRET=

# ── 弹幕 ────────────────────────────────────────────────

# 自建 danmu_api 地址，含 token 路径段。还需在后台开启「播放器弹幕」
# 不要指向他人的公开实例
# DANMAKU_API_BASE_URL=http://127.0.0.1:9321/yourtoken

# 弹幕服务在内网时显式放行；默认 false
# DANMAKU_API_ALLOW_PRIVATE=true

# ── 首次初始化默认值 ────────────────────────────────────

# 以下变量只用于首次生成站点配置，后台保存的配置优先
# NEXT_PUBLIC_SITE_NAME=IceTV
# NEXT_PUBLIC_SITE_ICON=
# ANNOUNCEMENT=
# NEXT_PUBLIC_SEARCH_MAX_PAGE=5
# NEXT_PUBLIC_FLUID_SEARCH=true
# NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false
# NEXT_PUBLIC_SOURCE_COVER_PROXY_MODE=auto
# NEXT_PUBLIC_DOUBAN_PROXY_TYPE=direct
# NEXT_PUBLIC_DOUBAN_PROXY=
# NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=direct
# NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=
# NEXT_PUBLIC_BANGUMI_DATA_SOURCE=direct
# NEXT_PUBLIC_BANGUMI_PROXY=

# 版本检查目标，默认 naseaoi/IceTV 与当前版本对应分支
# NEXT_PUBLIC_UPDATE_REPOS=naseaoi/IceTV
# NEXT_PUBLIC_UPDATE_BRANCH=main

# 构建时版本号，通常由 Docker/CI 注入；运行时无需设置
# NEXT_PUBLIC_APP_VERSION=

# ── 安全 ────────────────────────────────────────────────

# 反向代理层数。部署在 Nginx / Cloudflare 等反代后面必须设置
# 默认 0 时会取 x-forwarded-for 的第一段，该值客户端可伪造，注册限流会被绕过
# TRUSTED_PROXY_COUNT=1

# ── 本地开发 ────────────────────────────────────────────

# 让服务端出站请求走代理，仅非生产环境生效。两项都要设
# DEV_PROXY_ENABLED=true
# DEV_HTTP_PROXY=http://127.0.0.1:7890

# 开发环境定时任务。生产环境由 start.js / 平台 cron 负责
# DEV_CRON_DISABLED=true
# DEV_CRON_INITIAL_DELAY_MS=30000
# NO_PROXY=localhost,127.0.0.1,::1
