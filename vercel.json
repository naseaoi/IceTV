{
  "headers": [
    {
      "source": "/fonts/inter-var-latin.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?task=metadata",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron?task=config",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron?task=live",
      "schedule": "30 * * * *"
    }
  ]
}
