{
  "name": "icetv",
  "version": "0.3.7",
  "private": true,
  "scripts": {
    "dev": "pnpm gen:manifest && next dev --webpack -H 0.0.0.0",
    "build": "pnpm gen:changelog && pnpm gen:manifest && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:changelog": "node scripts/convert-changelog.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@serwist/next": "^9.5.7",
    "artplayer": "^5.2.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bs58": "^6.0.0",
    "he": "^1.2.0",
    "hls.js": "^1.6.10",
    "lucide-react": "^0.438.0",
    "mysql2": "^3.15.3",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "serwist": "^9.5.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^15.0.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored --ignore-pattern public/sw.js --ignore-pattern public/workbox-*.js",
      "prettier -w --ignore-unknown --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w --ignore-unknown --no-error-on-unmatched-pattern"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
