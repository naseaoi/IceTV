{
  "name": "icetv",
  "version": "0.4.9",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <25",
    "pnpm": ">=10.14.0"
  },
  "scripts": {
    "dev": "pnpm gen:changelog && pnpm gen:manifest && pnpm gen:dev-sw && next dev --turbopack -H 0.0.0.0",
    "dev:webpack": "pnpm gen:changelog && pnpm gen:manifest && pnpm gen:dev-sw && next dev --webpack -H 0.0.0.0",
    "build": "pnpm gen:changelog && pnpm gen:manifest && next build --webpack",
    "build:turbo": "pnpm gen:changelog && pnpm gen:manifest && next build --turbopack",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "check:encoding": "node scripts/check-encoding.js",
    "typecheck": "tsc --noEmit --incremental false",
    "perf:baseline": "node scripts/run-performance-baseline.js",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:dev-sw": "node scripts/generate-dev-sw.js",
    "gen:changelog": "node scripts/convert-changelog.js",
    "validate:changelog": "node scripts/convert-changelog.js",
    "release:prepare": "node scripts/prepare-release.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@serwist/next": "^9.5.7",
    "artplayer": "^5.2.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bs58": "^6.0.0",
    "he": "^1.2.0",
    "hls.js": "^1.6.10",
    "lucide-react": "^0.438.0",
    "mysql2": "^3.15.3",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "serwist": "^9.5.7",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/he": "^1.2.3",
    "@types/jest": "^27.5.2",
    "@types/node": "24.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "lint-staged": "^12.5.0",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "undici": "^8.5.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --quiet --no-warn-ignored --ignore-pattern public/sw.js --ignore-pattern public/workbox-*.js",
      "prettier -w --ignore-unknown --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w --ignore-unknown --no-error-on-unmatched-pattern"
    ]
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "@babel/plugin-transform-modules-systemjs@<=7.29.3": "7.29.7",
      "@tootallnate/once@<2.0.1": "2.0.1",
      "ajv@<6.14.0": "6.14.0",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "fast-uri@<3.1.2": "3.1.2",
      "flatted@<=3.4.1": "3.4.2",
      "form-data@>=3.0.0 <3.0.5": "3.0.5",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@<4.2.0": "4.2.0",
      "lodash@<=4.17.23": "4.18.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "postcss": "^8.5.15",
      "semver@>=7.0.0 <7.5.2": "7.5.2",
      "svgo@>=3.0.0 <3.3.3": "3.3.3",
      "webpack@>=5.49.0 <=5.104.0": "5.104.1",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "yaml@>=2.0.0 <2.8.3": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
